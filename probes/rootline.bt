#!/usr/bin/env bpftrace
/*
 * ROOTLINE reference probe (UNTESTED on this repo's CI - Grade C/D work).
 * Emits key=value lines that rootline.normalize.parse_bpftrace_line reads:
 *
 *   sudo bpftrace probes/rootline.bt > capture.log
 *   rootline analyze capture.log
 *
 * Observe-only: attaches to tracepoints, never modifies syscalls.
 * Run ONLY on a lab VM you own. Paths/argv are truncated by bpftrace limits.
 * TODO: filter the probe's own PID; capture read/write via vfs_* kprobes;
 *       resolve fd -> path for write(); IPv6 connect; ring-buffer libbpf port.
 */

tracepoint:sched:sched_process_fork
{
  printf("ts=%llu kind=fork pid=%d ppid=%d uid=%d comm=%s child_pid=%d\n",
         nsecs, args->parent_pid, curtask->real_parent->tgid, uid, comm, args->child_pid);
}

tracepoint:syscalls:sys_enter_execve
{
  printf("ts=%llu kind=execve pid=%d ppid=%d uid=%d comm=%s path=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm, str(args->filename));
}

tracepoint:syscalls:sys_enter_openat
{
  /* O_WRONLY=1 O_RDWR=2 O_CREAT=0100 */
  $w = (args->flags & 3) || (args->flags & 0100);
  printf("ts=%llu kind=openat pid=%d ppid=%d uid=%d comm=%s path=%s flags=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm, str(args->filename),
         $w ? "O_WRONLY" : "O_RDONLY");
}

tracepoint:syscalls:sys_enter_unlinkat
{
  printf("ts=%llu kind=unlinkat pid=%d ppid=%d uid=%d comm=%s path=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm, str(args->pathname));
}

kprobe:tcp_connect
{
  $sk = (struct sock *)arg0;
  printf("ts=%llu kind=connect pid=%d ppid=%d uid=%d comm=%s dst_ip=%s dst_port=%d\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm,
         ntop($sk->__sk_common.skc_daddr), bswap($sk->__sk_common.skc_dport));
}

tracepoint:sched:sched_process_exit
{
  printf("ts=%llu kind=exit pid=%d ppid=%d uid=%d comm=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm);
}
