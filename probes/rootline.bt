#!/usr/bin/env bpftrace
/*
 * ROOTLINE reference probe (v1.2). Exercised LIVE in CI: the `live-ebpf` job in
 * .github/workflows/ci.yml runs it with sudo on an Ubuntu runner while a scripted,
 * benign activity chain runs, then reconstructs the chain.
 *
 * Run it with JSON output and its own PID as the first argument, so it never
 * traces itself:
 *
 *   sudo sh -c 'exec bpftrace -f json probes/rootline.bt $$' > capture.jsonl
 *   rootline analyze capture.jsonl
 *
 * With -f json every record is a JSON string ({"type":"printf","data":...}), so a
 * file name or process name containing a newline cannot fake a second record.
 * Inside a record the layout is fixed: numeric fields first, then at most one
 * free-text path=, then comm= (<= 15 bytes) last. rootline.normalize parses it
 * with an anchored regex, so a crafted name cannot change the kind or the pids.
 *
 * Observe-only: attaches to tracepoints/kprobes, never modifies syscalls.
 * Run ONLY on a host you own. Needs kernel BTF (struct sock / task_struct).
 *
 * v1.2 over v1.1:
 *   - self filtering by PID ($1 = bpftrace's own PID), not by process name: a
 *     process that renames itself "bpftrace" is still traced;
 *   - process creation from kprobe:wake_up_new_task, reported only for new thread
 *     groups (threads are not processes) and with the parent's TGID as pid=;
 *   - fd -> path maps are keyed by (tgid, process start time, fd), so a recycled
 *     PID never inherits a dead process's fd paths.
 * Kept from v1.1: execve/openat reported at sys_exit only on success, the first
 * write() per opened fd carries its path, dup2/dup3 carry the path to the new fd,
 * IPv4 and IPv6 connect, tsns= nanosecond timestamps, exit only for the group leader.
 * Known gaps: relative paths are reported as passed to openat (no cwd/dirfd
 * resolution); dup()/fcntl(F_DUPFD) and fds inherited across fork are not
 * resolved; argv is not captured; paths are cut at bpftrace's 64-byte default
 * string size (raising it overflows the 512-byte BPF stack in the exit probes).
 */

kprobe:wake_up_new_task
/pid != $1/
{
  $t = (struct task_struct *)arg0;
  if ($t->tgid == $t->pid) {
    printf("tsns=%llu kind=fork pid=%d ppid=%d uid=%d child_pid=%d comm=%s\n",
           nsecs, pid, curtask->real_parent->tgid, uid, $t->pid, comm);
  }
}

tracepoint:syscalls:sys_enter_execve
/pid != $1/
{
  @exe[tid] = str(args->filename);
  @inexec[tid] = 1;
}

tracepoint:syscalls:sys_exit_execve
/@inexec[tid]/
{
  if (args->ret == 0) {
    printf("tsns=%llu kind=execve pid=%d ppid=%d uid=%d path=%s comm=%s\n",
           nsecs, pid, curtask->real_parent->tgid, uid, @exe[tid], comm);
  }
  delete(@exe[tid]);
  delete(@inexec[tid]);
}

tracepoint:syscalls:sys_enter_openat
/pid != $1/
{
  @opath[tid] = str(args->filename);
  /* O_WRONLY=1 O_RDWR=2 O_CREAT=0100 */
  @ow[tid] = (args->flags & 3) || (args->flags & 0100) ? 1 : 0;
  @inopen[tid] = 1;
}

tracepoint:syscalls:sys_exit_openat
/@inopen[tid]/
{
  if (args->ret >= 0) {
    printf("tsns=%llu kind=openat pid=%d ppid=%d uid=%d flags=%s fd=%d path=%s comm=%s\n",
           nsecs, pid, curtask->real_parent->tgid, uid,
           @ow[tid] ? "O_WRONLY" : "O_RDONLY", args->ret, @opath[tid], comm);
    if (@ow[tid]) {
      $st = curtask->group_leader->start_time;
      @wfd[pid, $st, args->ret] = @opath[tid];
      @wpending[pid, $st, args->ret] = 1;
      @wopen[pid, $st, args->ret] = 1;
    }
  }
  delete(@opath[tid]);
  delete(@ow[tid]);
  delete(@inopen[tid]);
}

tracepoint:syscalls:sys_enter_write
/@wpending[pid, curtask->group_leader->start_time, args->fd] == 1/
{
  /* fd -> path: report the first write() per (process, fd) with the path it was opened as */
  $st = curtask->group_leader->start_time;
  printf("tsns=%llu kind=write pid=%d ppid=%d uid=%d fd=%d path=%s comm=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, args->fd, @wfd[pid, $st, args->fd], comm);
  delete(@wpending[pid, $st, args->fd]);
}

/* shells redirect with open + dup2(fd, 1) + close(fd): carry the path to the new fd */
tracepoint:syscalls:sys_enter_dup2
/@wopen[pid, curtask->group_leader->start_time, args->oldfd]/
{
  $st = curtask->group_leader->start_time;
  @wfd[pid, $st, args->newfd] = @wfd[pid, $st, args->oldfd];
  @wpending[pid, $st, args->newfd] = 1;
  @wopen[pid, $st, args->newfd] = 1;
}

tracepoint:syscalls:sys_enter_dup3
/@wopen[pid, curtask->group_leader->start_time, args->oldfd]/
{
  $st = curtask->group_leader->start_time;
  @wfd[pid, $st, args->newfd] = @wfd[pid, $st, args->oldfd];
  @wpending[pid, $st, args->newfd] = 1;
  @wopen[pid, $st, args->newfd] = 1;
}

tracepoint:syscalls:sys_enter_close
/@wopen[pid, curtask->group_leader->start_time, args->fd]/
{
  $st = curtask->group_leader->start_time;
  delete(@wfd[pid, $st, args->fd]);
  delete(@wpending[pid, $st, args->fd]);
  delete(@wopen[pid, $st, args->fd]);
}

tracepoint:syscalls:sys_enter_unlinkat
/pid != $1/
{
  printf("tsns=%llu kind=unlinkat pid=%d ppid=%d uid=%d path=%s comm=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, str(args->pathname), comm);
}

kprobe:tcp_connect
/pid != $1/
{
  $sk = (struct sock *)arg0;
  $fam = $sk->__sk_common.skc_family;
  if ($fam == 2) {
    printf("tsns=%llu kind=connect pid=%d ppid=%d uid=%d dst_port=%d dst_ip=%s comm=%s\n",
           nsecs, pid, curtask->real_parent->tgid, uid,
           bswap($sk->__sk_common.skc_dport), ntop($sk->__sk_common.skc_daddr), comm);
  } else if ($fam == 10) {
    printf("tsns=%llu kind=connect pid=%d ppid=%d uid=%d dst_port=%d dst_ip=%s comm=%s\n",
           nsecs, pid, curtask->real_parent->tgid, uid,
           bswap($sk->__sk_common.skc_dport), ntop($sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), comm);
  }
}

tracepoint:sched:sched_process_exit
/pid != $1 && pid == tid/
{
  printf("tsns=%llu kind=exit pid=%d ppid=%d uid=%d comm=%s\n",
         nsecs, pid, curtask->real_parent->tgid, uid, comm);
}

END
{
  clear(@exe); clear(@inexec); clear(@opath); clear(@ow); clear(@inopen);
  clear(@wfd); clear(@wpending); clear(@wopen);
}
